# این فایل را به اسم .env کپی کنید و مقادیر را عوض کنید
# رمز ورود پنل صندوق
CASHIER_PASSWORD=cafe1234
# رمز ورود پنل مدیریت
ADMIN_PASSWORD=admin1234
# کلید امضای توکن — حتماً یک رشته تصادفی طولانی بگذارید
SECRET_KEY=change-me-to-a-long-random-string
# مدت اعتبار توکن (ساعت)
TOKEN_EXPIRE_HOURS=12
# آدرس فرانت برای CORS (اگر با پراکسی Vite اجرا می‌کنید نیازی به تغییر نیست)
CORS_ORIGINS=http://localhost:5173
# حالت تعطیل کافه (true=باز, false=بسته)
IS_OPEN=true
# نمایش Swagger UI و ReDoc — فقط برای توسعه؛ در production مقدار false بگذارید
DOCS_ENABLED=false
# ساخت داده اولیه منو وقتی دیتابیس خالی است (true=اجرا, false=غیرفعال)
SEED_ON_STARTUP=true
# سطح لاگ برنامه (DEBUG|INFO|WARNING|ERROR)
LOG_LEVEL=INFO
